 "win_routes": {
  "Ezio's elimination, made a table win by Ramses": {
   "cards": [
    "Ramses, Assassin Lord",
    "Unstoppable Slasher"
   ],
   "axis": "combat",
   "vs_three": "With Ramses on the battlefield, any opponent who loses the game after an Assassin attacked them that turn makes me win at once (ruling 2022-09-09: any cause of loss counts), so ONE elimination beats all three: Ezio connects with a player at 10 or less and {W}{U}{B}{R}{G} removes them, or plain combat damage does. Unstoppable Slasher halves a player's life on a hit, and with Ezio in the same combat a player at 26 or less is removed (Slasher's trigger resolves first). On the kill turn every opponent is attacked by at least one Assassin. Without Ramses the route repeats once per opponent. Ramses is found by Diabolic Tutor, by Entomb plus Restart Sequence, Layla, Jacob, Altair or The Revelations of Ezio."
  },
  "Assassin team beatdown": {
   "cards": [
    "Arno Dorian",
    "Bayek of Siwa",
    "Rally the Peasants",
    "Eivor, Wolf-Kissed"
   ],
   "axis": "combat",
   "vs_three": "Five or six Assassins split their attacks over the three opponents each turn: Arno gives every other Assassin +2/+0, Bayek gives the legendary attackers double strike on my turn, Rally the Peasants adds +2/+0 to the whole team at instant speed and again with flashback, Eivor is a 7/6 trampler for {B}{B}. Each of these raises the damage on all three players at once, and each kill by damage is also a Ramses win."
  },
  "Noncombat damage to each opponent": {
   "cards": [
    "Arbaaz Mir",
    "Shao Jun"
   ],
   "axis": "noncombat",
   "vs_three": "Both hit EACH opponent without passing a blocker: Arbaaz Mir deals 1 to each opponent whenever a nontoken historic permanent enters under my control (40 of the 99 cards are legendary, artifacts or the Saga, and each recast of Ezio counts), and Shao Jun deals 1 to each opponent for every two untapped artifacts I tap (17 artifacts; tapped Equipment keeps working). Together they bring all three players toward 10 at the same time, where Ezio's trigger or one attack finishes each of them."
  }
