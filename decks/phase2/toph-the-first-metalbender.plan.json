  "win_routes": {
    "landfall burn": {
      "cards": [
        "Tannuk, Memorial Ensign",
        "Sabotender",
        "Valakut Exploration",
        "Arbaaz Mir",
        "Fire Nation Archers"
      ],
      "axis": "noncombat",
      "vs_three": "Every land entry deals 1 damage to EACH opponent per pinger (Arbaaz: every artifact or legendary entry), Valakut Exploration deals end-step damage to each opponent, and Fire Nation Archers turns spare mana into 2 to each opponent per {5} (10 to 15 mana by turns 7 to 8: 4 to 6 to everyone a turn). Realistic board: one pinger (46 % by turn 7, 54 % with Chord) at 3 entries a turn = 3 to each opponent a turn, plus Archers late; two pingers at once is the best case (9.5 % by turn 7). All three opponents fall together."
    },
    "artifact burst": {
      "cards": [
        "Ragost, Deft Gastronaut",
        "Goblin Bombardment"
      ],
      "axis": "noncombat",
      "vs_three": "Ragost turns every artifact (Treasures, Clues, Foods, rocks, the artifact-lands Toph makes) into 3 damage to EACH opponent and untaps at every end step after any lifegain (Zuran Orb at instant speed, Druid Class, Arbaaz Mir), so it fires up to four times per turn cycle, 12 to each opponent; Goblin Bombardment converts land creatures and tokens into the last points on whoever is left."
    },
    "land army": {
      "cards": [
        "The Earth King",
        "Rampaging Baloths",
        "Seismic Tutelage",
        "Bumi, Unleashed",
        "Titania, Protector of Argoth",
        "Toph, the Blind Bandit"
      ],
      "axis": "combat",
      "vs_three": "Attacks with several power-4+ creatures make The Earth King fetch that many basics (more Baloths beasts and pings), Garruk's Uprising and Earthbender Ascension give trample over chump blockers, Bumi's connection untaps every land for a second combat of land creatures; attackers are split to finish the weakest players while the pings hit all three, and the earthbent attackers return to play when they die."
    },
    "infinite landfall": {
      "cards": [
        "Springheart Nantuko",
        "Lotus Cobra",
        "Tireless Provisioner",
        "Ashaya, Soul of the Wild"
      ],
      "axis": "noncombat",
      "vs_three": "Three-card loops made of on-plan cards (Spellbook 3470-5702-6871, 3875-5702-6871, 539-1315-7037, 539-5147-7037): R8 Toph + Springheart Nantuko CAST for bestow on her end-step earthbent land + Lotus Cobra or Tireless Provisioner = infinite landfall (each copy is a land that enters untapped and pays the next {1}{G}); closers: Sabotender, Tannuk, Valakut Exploration (whole library to each opponent at end step), Fire Nation Archers when the loop also nets mana (Cobra and Provisioner both out); Arbaaz does NOT trigger (the copies are tokens). R9 Ashaya + Toph, the Blind Bandit + Zuran Orb or Goblin Bombardment = the Bandit is a land, earthbends herself on entry and returns when sacrificed: infinite landfall, and Arbaaz triggers too (a nontoken legend enters each loop); Bombardment alone kills the table. Every opponent dies at once."
    }
