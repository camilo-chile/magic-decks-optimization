 "win_routes": {
  "Darksteel Reactor funnel": {
   "cards": [
    "Darksteel Reactor",
    "Resourceful Defense",
    "Moxite Refinery"
   ],
   "axis": "alternate",
   "vs_three": "Darksteel Reactor wins the game against all three opponents at 20 charge counters. Kilo proliferates it every turn (doubled by Tekuthal, doubled at once by Deepglow Skate), Coretapper and Inspirit add charge counters, and the two funnels finish it: Resourceful Defense ({4}{W}, any time) moves every counter of one permanent onto the Reactor (Inspirit's 8+ charge counters, Uthros, Empowered Autogenerator, Titan Forge, Lux Cannon, the rocks), and Moxite Refinery (sorcery) turns X counters of any kind, +1/+1 included, into X charge counters on it. Resourceful Defense also moves the counters of any permanent that dies onto the Reactor. With 25 to 40 counters on the board by turns 7 to 9, one or two funnel activations win. The Reactor is indestructible."
  },
  "Lux Artillery burn": {
   "cards": [
    "Lux Artillery",
    "Reckless Fireweaver"
   ],
   "axis": "noncombat",
   "vs_three": "Lux Artillery deals 10 to EACH opponent at every end step once 30 counters sit on my artifacts and creatures; Reckless Fireweaver pings each opponent for every artifact entry; Phyrexian Metamorph copying Lux doubles it to 20 each."
  },
