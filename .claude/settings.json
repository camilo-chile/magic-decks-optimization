{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "WebFetch(domain:api.scryfall.com)",
      "WebFetch(domain:backend.commanderspellbook.com)"
    ],
    "ask": [
      "Edit(./.githooks/**)",
      "Edit(./.gitignore)",
      "Edit(./.gitattributes)",
      "Edit(./.claude/settings.json)",
      "Edit(./.claude/settings.local.json)",
      "Edit(./.claude/hooks/**)"
    ],
    "deny": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "PowerShell(git commit *)",
      "PowerShell(git push *)",
      "Read(**/.env)",
      "Read(**/.env.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR}/.claude/hooks/block-git-writes.sh\""
          }
        ]
      }
    ]
  }
}
